---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---
<BaseLayout
  title="About - Elhan Iqbal"
  description="About Elhan Iqbal, a curious engineer based in Vancouver."
>
  <div class="container">
    <div class="page-intro">
      <span class="label">About</span>
      <h1>I like engineering that has real constraints and exploring problems across different realms.</h1>
      <p>
        UBC Integrated Engineering graduate based in Vancouver. I like to work across software, infrastructure,
        robotics, security, and applied ML: projects where backend reliability, cloud operations, sometimes
        physical hardware, and user experience all have to work together.
      </p>
    </div>

    <div class="about-content">
      <div class="about-card">
        <h2>What I like to work on</h2>
        <ul class="clean-list">
          <li>Cloud infrastructure: Terraform, GCP, AWS IAM, Kubernetes, CI/CD</li>
          <li>Systems with real deployment and operational constraints</li>
          <li>Applied ML and privacy research: membership inference, data leakage, LLMs</li>
          <li>Embedded and robotics work: Raspberry Pi, Klipper, MQTT, FastAPI</li>
        </ul>
      </div>

      <div class="about-card">
        <h2>Contact</h2>
        <div class="contact-list">
          <span>Email: <a href={`mailto:${site.email}`}>{site.email}</a></span>
          <span><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></span>
          <span><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></span>
          <span><a href={site.resume} target="_blank" rel="noopener noreferrer">Resume (PDF)</a></span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
