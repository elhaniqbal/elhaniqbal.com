---
import BaseLayout from '../layouts/BaseLayout.astro';

// Web3Forms access key — public by design (it only identifies the inbox,
// submissions are rate-limited and spam-filtered on their side).
const WEB3FORMS_ACCESS_KEY = 'b69753dc-008a-40f6-8676-29ab9551f7d6';
const redirectUrl = new URL('/thanks', Astro.site).href;
---
<BaseLayout
  title="Contact - Elhan Iqbal"
  description="Get in touch with Elhan Iqbal — software, infrastructure, and platform engineering."
>
  <div class="container">
    <div class="page-intro">
      <span class="label">Contact</span>
      <h1>Get in touch.</h1>
      <p>
        Whether it's a role, a project, a correction to something I wrote on the blog, or just
        a question — I'd like to hear it.
      </p>
    </div>

    <div class="contact-content">
      <div class="contact-card">
        <h2>Send a message</h2>
        <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value="New message from elhaniqbal.com" />
          <input type="hidden" name="redirect" value={redirectUrl} />
          <!-- Honeypot: hidden from humans, bots that fill it are dropped by Web3Forms -->
          <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

          <label>
            Name
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            Email
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            Message
            <textarea name="message" rows="6" required></textarea>
          </label>

          <!-- hCaptcha: Web3Forms verifies the token server-side and rejects
               submissions without a valid solve, so bots can't bypass it by
               POSTing to the API directly. Uses Web3Forms' shared site key. -->
          <div class="h-captcha" data-captcha="true"></div>

          <button class="btn btn-primary" type="submit">Send message</button>
        </form>
        <script src="https://web3forms.com/client/script.js" async defer is:inline></script>
      </div>
    </div>
  </div>
</BaseLayout>
