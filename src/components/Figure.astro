---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;

// The prose column is ~68ch (~720px), so 1440px covers 2x displays.
// Never request a width larger than the source — sharp won't upscale.
const widths = [480, 800, 1080, 1440].filter((w) => w < src.width);
widths.push(src.width);
---
<figure>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes="(max-width: 768px) 100vw, 720px"
    format="avif"
    loading="lazy"
  />
  {Astro.slots.has('default') && (
    <figcaption><slot /></figcaption>
  )}
</figure>
