---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = site.pitch
} = Astro.props;

const path = Astro.url.pathname;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..400&family=Lora:ital,wght@0,400..600;1,400..500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Home">
          <span class="brand-mark">EI</span>
          <span>{site.name}</span>
        </a>
        <div class="header-right">
          <nav class="nav" id="site-nav" aria-label="Main navigation">
            <a class="nav-link" href="/projects" aria-current={path.startsWith('/projects') ? 'page' : undefined}>Projects</a>
            <a class="nav-link" href="/blog" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
            <a class="nav-link" href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>Contact</a>
            <!-- Mobile only: duplicates the Resume pill, which is hidden below 768px -->
            <a class="nav-link nav-link-resume" href={site.resume} target="_blank" rel="noopener">Resume</a>
          </nav>
          <a class="nav-contact" href={site.resume} target="_blank" rel="noopener">Resume</a>
          <button class="theme-btn" id="theme-toggle" aria-label="Toggle color scheme" type="button"></button>
          <button class="menu-btn" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav" type="button"></button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {year} {site.name}. All rights reserved.</span>
        <div class="footer-links">
          <a href="/contact">Contact</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={site.resume}>Resume</a>
        </div>
      </div>
    </footer>

    <!-- Bundled (not is:inline) so Astro processes and caches it with the
         rest of the JS; it runs after DOM parse, which is all it needs. -->
    <script>
      (function () {
        var MOON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
        var SUN = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>';

        function syncBtn() {
          var isDark = document.documentElement.dataset.theme === 'dark';
          var btn = document.getElementById('theme-toggle');
          if (!btn) return;
          btn.innerHTML = isDark ? SUN : MOON;
          btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        }

        syncBtn();

        var btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.addEventListener('click', function () {
            var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            localStorage.setItem('theme', next);
            document.documentElement.dataset.theme = next;
            syncBtn();
          });
        }

        // Mobile menu toggle
        var MENU = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>';
        var CLOSE = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';

        // const (not var) so TypeScript keeps the null-narrowing from the
        // `if (menuBtn && nav)` guard alive inside the event-listener closures.
        const menuBtn = document.getElementById('menu-toggle');
        const nav = document.getElementById('site-nav');

        function setMenu(open: boolean) {
          if (!menuBtn || !nav) return;
          nav.classList.toggle('open', open);
          menuBtn.innerHTML = open ? CLOSE : MENU;
          menuBtn.setAttribute('aria-expanded', String(open));
          menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        }

        if (menuBtn && nav) {
          setMenu(false);
          menuBtn.addEventListener('click', function () {
            setMenu(!nav.classList.contains('open'));
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') setMenu(false);
          });
          // Pages load fully on navigation, but close eagerly so the menu
          // doesn't linger over the old page while the next one loads.
          nav.addEventListener('click', function (e) {
            if (e.target instanceof HTMLAnchorElement) setMenu(false);
          });
        }
      })();
    </script>
  </body>
</html>
