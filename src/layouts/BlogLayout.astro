---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/date';
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} - Blog`} description={frontmatter.description}>
  <article class="blog-post container">
    <a class="back-link" href="/blog">← All posts</a>
    <header class="post-header">
      <div class="post-meta">
        <div class="post-dates">
          <span>{formatDate(frontmatter.date)}</span>
          {frontmatter.lastUpdated && (
            <span class="post-updated-badge">Updated {formatDate(frontmatter.lastUpdated)}</span>
          )}
        </div>
        {frontmatter.tags.length > 0 && (
          <div class="tag-list">
            {frontmatter.tags.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
      <h1>{frontmatter.title}</h1>
      <p class="post-desc">{frontmatter.description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
