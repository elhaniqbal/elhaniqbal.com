/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Static allowlist CSP ('unsafe-inline' rather than per-build hashes — see
  # astro.config.mjs for why). Directives, by exception to default-src 'none':
  #   script/style: self + inline; web3forms + hcaptcha serve the contact-form captcha
  #   style: googleapis serves the Google Fonts stylesheet, gstatic the font files
  #   frame-src: YouTube embeds (privacy-enhanced domain) + hCaptcha challenge iframe
  #   connect-src: Astro prefetch (self) + hCaptcha verification XHR
  #   form-action: the contact form POSTs directly to Web3Forms
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://web3forms.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data:; media-src 'self'; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://hcaptcha.com https://*.hcaptcha.com; frame-src https://www.youtube-nocookie.com https://hcaptcha.com https://*.hcaptcha.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  # TEMPORARY
  X-Robots-Tag: noindex
